{
  "listen": "127.0.0.1:8080",
  "server_keys": ["change-this-local-key"],
  "zen_keys": ["REPLACE_WITH_YOUR_GEMINI_API_KEY"],
  "go_keys": [],
  "prefer": "zen",
  "upstream_mode": "openai",
  "proxies": ["direct"],
  "upstream": {
    "zen": "https://generativelanguage.googleapis.com/v1beta/openai",
    "go": "https://your-second-openai-compatible-upstream.example"
  },
  "retry": {
    "max_attempts": 3,
    "timeout_seconds": 300
  },
  "models": {
    "refresh_seconds": 300,
    "protocols": {},
    "static": [
      "gemini-3.7-flash",
      "gemini-3.6-flash",
      "gemini-3.5-flash",
      "gemini-3.5-flash-lite",
      "gemini-2.5-flash",
      "gemini-2.5-flash-lite",
      "gemini-2.5-pro",
      "gemini-2.0-flash",
      "gemini-2.0-flash-lite",
      "gemini-1.5-flash"
    ],
    "static_go": [
      "model-on-second-upstream"
    ]
  },
  "performance": {
    "max_idle_conns": 2048,
    "max_idle_conns_per_host": 256,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 120,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15
  },
  "logging": {
    "level": "info"
  },
  "stats": {
    "audit_file": "opencode2api.audit.jsonl"
  },
  "sanitize": {
    "enabled": true,
    "strip_free_suffix": false,
    "model_aliases": {}
  },
  "failover": {
    "enabled": true,
    "quota_cooldown_minutes": 30,
    "treat_generic_429_as_quota": false,
    "multi_account": true,
    "quota_park_minutes": 0,
    "throttle": {
      "initial_seconds": 30,
      "max_seconds": 300,
      "shared_429_threshold": 2,
      "max_wait_seconds": 30
    }
  },
  "fingerprint": {
    "enabled": false,
    "persist_file": "fingerprints.json"
  },
  "rate_limit": {
    "enabled": true,
    "proactive": true,
    "rotate_at_remaining": 2
  }
}
